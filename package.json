{
  "name": "hotel-park-plaza-erp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "install:all": "npm install",
    "db:generate": "npm run prisma:generate --workspace server",
    "db:push": "cd server && npx prisma db push",
    "db:migrate": "npm run prisma:migrate --workspace server",
    "db:seed": "npm run prisma:seed --workspace server",
    "db:demo": "npm run db:seed",
    "db:reset-demo": "node server/scripts/reset-demo.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
